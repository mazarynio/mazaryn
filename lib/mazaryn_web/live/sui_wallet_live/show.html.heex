<.live_component
  module={MazarynWeb.HomeLive.NavComponent}
  id="navigation"
  user={@current_user}
  search=""
  locale={@locale}
/>

<div class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950">
  <div class="max-w-7xl mx-auto px-6 py-10">

    <div class="flex items-center gap-3 mb-8">
      <.link
        navigate={~p"/#{@locale}/wallet"}
        class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-all text-sm font-medium"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        All Wallets
      </.link>
      <svg class="w-4 h-4 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
      <span class="text-slate-400 text-sm truncate max-w-xs"><%= to_string(@wallet.label || "Sui Wallet") %></span>
    </div>

    <%
      addr   = to_string(@wallet.sui_address || "")
      wid    = to_string(@wallet.wallet_id   || "")
      lbl    = to_string(@wallet.label       || "Sui Wallet")
      net    = to_string(@wallet.network     || "mainnet")
      scheme = to_string(@wallet.scheme      || "ed25519")
      addr_short = if String.length(addr) > 20, do: String.slice(addr, 0, 10) <> "...." <> String.slice(addr, -8, 8), else: addr

      sui_balance = Enum.find(@coin_balances, fn b -> to_string(b.coin_type) == "0x2::sui::SUI" end)
      sui_balance_str = if sui_balance, do: format_mist(sui_balance.total_balance), else: "0.000000000"
    %>

    <div class={"relative overflow-hidden rounded-3xl p-8 mb-8 shadow-2xl #{if @wallet.is_primary, do: "bg-gradient-to-br from-cyan-900/90 via-teal-900/90 to-slate-900/90 border border-cyan-500/40", else: "bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 border border-slate-700"}"}>
      <div class="flex items-start justify-between mb-6">
        <div class="flex items-center gap-4">
          <div class={"w-14 h-14 rounded-2xl flex items-center justify-center flex-shrink-0 #{if @wallet.is_primary, do: "bg-gradient-to-br from-cyan-500 to-teal-600 shadow-lg", else: "bg-slate-800"}"}>
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
          </div>
          <div>
            <div class="flex items-center gap-2 flex-wrap">
              <h1 class="text-2xl font-bold text-white"><%= lbl %></h1>
              <%= if @wallet.is_primary do %>
                <span class="px-2 py-0.5 bg-cyan-500/20 border border-cyan-500/30 text-cyan-300 text-xs font-semibold rounded-full">Primary</span>
              <% end %>
              <span class={"px-2 py-0.5 rounded-full text-xs font-semibold #{if net == "mainnet", do: "bg-cyan-500/20 border border-cyan-500/30 text-cyan-300", else: "bg-yellow-500/20 border border-yellow-500/30 text-yellow-300"}"}>
                <%= net %>
              </span>
              <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-700/50 border border-slate-600/30 text-slate-400">
                <%= scheme %>
              </span>
            </div>
            <div class="flex items-center gap-2 mt-1">
              <span class="text-slate-400 text-sm font-mono"><%= addr_short %></span>
              <button onclick={"navigator.clipboard.writeText('#{addr}')"} class="text-slate-600 hover:text-slate-300 transition-colors">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
              </button>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <button phx-click="open_update_label_modal" class="flex items-center gap-1.5 px-3 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
            Rename
          </button>
          <%= if not @wallet.is_primary do %>
            <button phx-click="set_primary" class="flex items-center gap-1.5 px-3 py-2 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/30 rounded-xl text-cyan-300 text-xs font-semibold transition-all">Set Primary</button>
          <% end %>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">
        <div class="bg-white/5 rounded-2xl p-4">
          <div class="text-slate-400 text-xs mb-1">SUI Balance</div>
          <div class="text-2xl font-bold text-white"><%= sui_balance_str %></div>
          <div class="text-slate-500 text-xs">SUI</div>
        </div>
        <div class="bg-white/5 rounded-2xl p-4">
          <div class="text-slate-400 text-xs mb-1">Transactions</div>
          <div class="text-2xl font-bold text-white"><%= length(@transactions) %></div>
          <div class="text-slate-500 text-xs">Total</div>
        </div>
        <div class="bg-white/5 rounded-2xl p-4">
          <div class="text-slate-400 text-xs mb-1">Coin Types</div>
          <div class="text-2xl font-bold text-white"><%= length(@coin_balances) %></div>
          <div class="text-slate-500 text-xs">Balances</div>
        </div>
        <div class="bg-white/5 rounded-2xl p-4">
          <div class="text-slate-400 text-xs mb-1">Objects / NFTs</div>
          <div class="text-2xl font-bold text-white"><%= length(@objects) %></div>
          <div class="text-slate-500 text-xs"><%= length(@nfts) %> NFTs</div>
        </div>
        <div class="bg-white/5 rounded-2xl p-4">
          <div class="text-slate-400 text-xs mb-1">Stakes</div>
          <div class="text-2xl font-bold text-white"><%= length(@stakes) %></div>
          <div class="text-slate-500 text-xs">Validators</div>
        </div>
      </div>
    </div>

    <div class="flex items-center gap-1 mb-6 bg-slate-900/60 rounded-2xl p-1.5 w-fit border border-slate-800 flex-wrap">
      <%= for {tab, label} <- [
        {"overview",      "Overview"},
        {"transactions",  "Transactions"},
        {"coins",         "Coins"},
        {"objects",       "Objects & NFTs"},
        {"stakes",        "Staking"}
      ] do %>
        <button
          phx-click="switch_tab"
          phx-value-tab={tab}
          class={"px-4 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 #{if @active_tab == tab, do: "bg-gradient-to-r from-cyan-600 to-teal-600 text-white shadow-lg", else: "text-slate-400 hover:text-white"}"}
        >
          <%= label %>
        </button>
      <% end %>
    </div>

    <%= if @active_tab == "overview" do %>
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <div class="lg:col-span-2 space-y-5">
          <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6">
            <h3 class="text-white font-bold mb-4">Wallet Details</h3>
            <div class="space-y-3">
              <div class="flex items-start justify-between py-2.5 border-b border-slate-800">
                <span class="text-slate-500 text-sm">Sui Address</span>
                <div class="flex items-center gap-2">
                  <span class="text-slate-300 text-xs font-mono break-all text-right max-w-xs"><%= addr %></span>
                  <button onclick={"navigator.clipboard.writeText('#{addr}')"} class="text-slate-600 hover:text-slate-300 flex-shrink-0">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                  </button>
                </div>
              </div>
              <div class="flex items-center justify-between py-2.5 border-b border-slate-800">
                <span class="text-slate-500 text-sm">Key Scheme</span>
                <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-slate-700/50 border border-slate-600/30 text-slate-300"><%= scheme %></span>
              </div>
              <div class="flex items-center justify-between py-2.5 border-b border-slate-800">
                <span class="text-slate-500 text-sm">Network</span>
                <span class={"px-2.5 py-1 rounded-full text-xs font-semibold #{if net == "mainnet", do: "bg-cyan-500/20 border border-cyan-500/30 text-cyan-300", else: "bg-yellow-500/20 border border-yellow-500/30 text-yellow-300"}"}><%= net %></span>
              </div>
              <div class="flex items-center justify-between py-2.5 border-b border-slate-800">
                <span class="text-slate-500 text-sm">Created</span>
                <span class="text-slate-300 text-sm"><%= format_datetime(@wallet.created_at) %></span>
              </div>
              <div class="flex items-center justify-between py-2.5 border-b border-slate-800">
                <span class="text-slate-500 text-sm">Last Used</span>
                <span class="text-slate-300 text-sm"><%= format_datetime(@wallet.last_used) %></span>
              </div>
              <div class="flex items-center justify-between py-2.5">
                <span class="text-slate-500 text-sm">Primary Wallet</span>
                <span class={"px-2.5 py-1 rounded-full text-xs font-semibold #{if @wallet.is_primary, do: "bg-cyan-500/20 border border-cyan-500/30 text-cyan-300", else: "bg-slate-700/50 border border-slate-600/30 text-slate-400"}"}>
                  <%= if @wallet.is_primary, do: "Yes", else: "No" %>
                </span>
              </div>
            </div>
          </div>

          <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-white font-bold">Coin Balances</h3>
              <button phx-click="refresh_balances" class="text-slate-400 hover:text-white text-xs">↻ Refresh</button>
            </div>
            <%= if length(@coin_balances) == 0 do %>
              <p class="text-slate-500 text-sm text-center py-6">No coin balances synced yet.</p>
            <% else %>
              <div class="space-y-2">
                <%= for bal <- @coin_balances do %>
                  <div class="flex items-center justify-between p-3 bg-slate-800/50 rounded-xl">
                    <div class="flex items-center gap-2">
                      <div class="w-7 h-7 bg-cyan-500/20 rounded-lg flex items-center justify-center">
                        <span class="text-cyan-400 text-xs font-bold"><%= coin_type_short(bal.coin_type) |> String.slice(0, 2) |> String.upcase() %></span>
                      </div>
                      <span class="text-slate-300 text-xs"><%= coin_type_short(bal.coin_type) %></span>
                    </div>
                    <div class="text-right">
                      <div class="text-white font-bold text-sm"><%= format_mist(bal.total_balance) %></div>
                      <div class="text-slate-500 text-xs"><%= to_string(bal.coin_object_count || 0) %> object(s)</div>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>

          <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-white font-bold">Recent Transactions</h3>
              <button phx-click="switch_tab" phx-value-tab="transactions" class="text-cyan-400 text-xs hover:text-cyan-300">View all →</button>
            </div>
            <%= if length(@transactions) == 0 do %>
              <div class="text-center py-8">
                <p class="text-slate-500 text-sm">No transactions yet.</p>
                <.link navigate={~p"/#{@locale}/sui/#{wid}/send"} class="inline-block mt-3 text-cyan-400 text-xs hover:text-cyan-300">Send your first transaction →</.link>
              </div>
            <% else %>
              <div class="space-y-2">
                <%= for tx <- Enum.take(@transactions, 5) do %>
                  <div class="flex items-center justify-between p-3 bg-slate-800/50 rounded-xl">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 bg-slate-700 rounded-lg flex items-center justify-center text-sm">
                        <%= tx_type_icon(tx.tx_type) %>
                      </div>
                      <div>
                        <div class="text-white text-sm font-medium"><%= String.replace(to_string(tx.tx_type || "transaction"), "_", " ") %></div>
                        <div class="text-slate-500 text-xs font-mono"><%= truncate_addr(tx.digest) %></div>
                      </div>
                    </div>
                    <div class="text-right">
                      <%= if tx.amount_mist && to_string(tx.amount_mist) != "" do %>
                        <div class="text-white text-sm font-bold"><%= format_mist(tx.amount_mist) %> SUI</div>
                      <% end %>
                      <span class={"px-1.5 py-0.5 rounded text-xs font-semibold #{tx_status_class(tx.status)}"}>
                        <%= to_string(tx.status || "unknown") %>
                      </span>
                    </div>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>

        <div class="space-y-5">
          <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6">
            <h3 class="text-white font-bold mb-4">Quick Actions</h3>
            <div class="space-y-2">
              <.link navigate={~p"/#{@locale}/sui/#{wid}/send"} class="flex items-center gap-3 p-3 bg-gradient-to-r from-cyan-600/20 to-teal-600/20 border border-cyan-500/20 rounded-xl hover:from-cyan-600/30 hover:to-teal-600/30 transition-all">
                <div class="w-8 h-8 bg-cyan-500/20 rounded-lg flex items-center justify-center">
                  <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
                  </svg>
                </div>
                <span class="text-white text-sm font-semibold">Send SUI</span>
              </.link>
              <.link navigate={~p"/#{@locale}/sui/#{wid}/transactions"} class="flex items-center gap-3 p-3 bg-slate-800/60 rounded-xl hover:bg-slate-800 transition-all">
                <div class="w-8 h-8 bg-slate-700 rounded-lg flex items-center justify-center">
                  <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                  </svg>
                </div>
                <span class="text-white text-sm font-semibold">Transaction History</span>
              </.link>
              <.link navigate={~p"/#{@locale}/sui/#{wid}/tokens"} class="flex items-center gap-3 p-3 bg-slate-800/60 rounded-xl hover:bg-slate-800 transition-all">
                <div class="w-8 h-8 bg-teal-500/20 rounded-lg flex items-center justify-center">
                  <svg class="w-4 h-4 text-teal-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <span class="text-white text-sm font-semibold">Coins & Balances</span>
              </.link>
              <.link navigate={~p"/#{@locale}/sui/#{wid}/nfts"} class="flex items-center gap-3 p-3 bg-slate-800/60 rounded-xl hover:bg-slate-800 transition-all">
                <div class="w-8 h-8 bg-pink-500/20 rounded-lg flex items-center justify-center">
                  <svg class="w-4 h-4 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <span class="text-white text-sm font-semibold">Objects & NFTs</span>
              </.link>
              <.link navigate={~p"/#{@locale}/sui/#{wid}/stake"} class="flex items-center gap-3 p-3 bg-slate-800/60 rounded-xl hover:bg-slate-800 transition-all">
                <div class="w-8 h-8 bg-green-500/20 rounded-lg flex items-center justify-center">
                  <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                  </svg>
                </div>
                <span class="text-white text-sm font-semibold">Staking</span>
              </.link>
            </div>
          </div>

          <%= if length(@stakes) > 0 do %>
            <div class="bg-green-900/20 border border-green-500/20 rounded-3xl p-6">
              <h3 class="text-white font-bold mb-3">Staking Summary</h3>
              <%
                total_staked = @stakes
                  |> Enum.map(fn s -> case Integer.parse(to_string(s.principal_mist || "0")) do {n, _} -> n; :error -> 0 end end)
                  |> Enum.sum()
              %>
              <div class="text-2xl font-bold text-green-400 mb-1"><%= format_mist(total_staked) %> SUI</div>
              <div class="text-green-600 text-xs">Across <%= length(@stakes) %> validator(s)</div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= if @active_tab == "transactions" do %>
      <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6">
        <div class="flex items-center justify-between mb-5">
          <h3 class="text-white font-bold text-lg">Transaction History</h3>
          <div class="flex items-center gap-3">
            <button phx-click="refresh_transactions" class="text-slate-400 hover:text-white text-xs">↻ Refresh</button>
            <.link navigate={~p"/#{@locale}/sui/#{wid}/transactions"} class="text-cyan-400 hover:text-cyan-300 text-xs">Full view →</.link>
          </div>
        </div>
        <%= if length(@transactions) == 0 do %>
          <div class="text-center py-16">
            <p class="text-slate-500 mb-3">No transactions yet.</p>
            <.link navigate={~p"/#{@locale}/sui/#{wid}/send"} class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-cyan-600 to-teal-600 text-white rounded-xl text-sm font-semibold">Send SUI</.link>
          </div>
        <% else %>
          <div class="space-y-2">
            <%= for tx <- @transactions do %>
              <div class="flex items-center justify-between p-4 bg-slate-800/50 border border-slate-700/50 rounded-2xl">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-slate-700 rounded-xl flex items-center justify-center text-lg"><%= tx_type_icon(tx.tx_type) %></div>
                  <div>
                    <div class="text-white font-semibold"><%= String.replace(to_string(tx.tx_type || "transaction"), "_", " ") %></div>
                    <div class="text-slate-500 text-xs font-mono"><%= truncate_addr(tx.digest) %></div>
                    <%= if tx.recipient_address && to_string(tx.recipient_address) != "" do %>
                      <div class="text-slate-600 text-xs">To: <%= truncate_addr(tx.recipient_address) %></div>
                    <% end %>
                    <%= if tx.validator_address && to_string(tx.validator_address) != "" do %>
                      <div class="text-slate-600 text-xs">Validator: <%= truncate_addr(tx.validator_address) %></div>
                    <% end %>
                  </div>
                </div>
                <div class="text-right">
                  <%= if tx.amount_mist && to_string(tx.amount_mist) != "" do %>
                    <div class="text-white font-bold"><%= format_mist(tx.amount_mist) %> SUI</div>
                  <% end %>
                  <%= if tx.checkpoint && to_string(tx.checkpoint) != "" do %>
                    <div class="text-slate-500 text-xs">Checkpoint: <%= to_string(tx.checkpoint) %></div>
                  <% end %>
                  <span class={"px-2 py-0.5 rounded-full text-xs font-semibold #{tx_status_class(tx.status)}"}>
                    <%= to_string(tx.status || "unknown") %>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= if @active_tab == "coins" do %>
      <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6">
        <div class="flex items-center justify-between mb-5">
          <h3 class="text-white font-bold text-lg">Coin Balances</h3>
          <div class="flex items-center gap-3">
            <button phx-click="refresh_balances" class="text-slate-400 hover:text-white text-xs">↻ Refresh</button>
            <.link navigate={~p"/#{@locale}/sui/#{wid}/tokens"} class="text-cyan-400 hover:text-cyan-300 text-xs">Full view →</.link>
          </div>
        </div>
        <%= if length(@coin_balances) == 0 do %>
          <div class="text-center py-16"><p class="text-slate-500 text-sm">No coin balances synced yet.</p></div>
        <% else %>
          <div class="space-y-3">
            <%= for bal <- @coin_balances do %>
              <div class="flex items-center justify-between p-4 bg-slate-800/50 border border-slate-700/50 rounded-2xl">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-cyan-500/20 rounded-xl flex items-center justify-center">
                    <span class="text-cyan-400 font-bold text-sm"><%= coin_type_short(bal.coin_type) |> String.slice(0, 2) |> String.upcase() %></span>
                  </div>
                  <div>
                    <div class="text-white font-semibold"><%= coin_type_short(bal.coin_type) %></div>
                    <div class="text-slate-500 text-xs font-mono truncate max-w-xs"><%= to_string(bal.coin_type || "") %></div>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-white font-bold text-lg"><%= format_mist(bal.total_balance) %></div>
                  <div class="text-slate-500 text-xs"><%= to_string(bal.coin_object_count || 0) %> coin object(s)</div>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%= if @active_tab == "objects" do %>
      <div class="space-y-5">
        <%= if length(@nfts) > 0 do %>
          <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6">
            <div class="flex items-center justify-between mb-5">
              <h3 class="text-white font-bold text-lg">NFTs</h3>
              <div class="flex items-center gap-3">
                <button phx-click="refresh_objects" class="text-slate-400 hover:text-white text-xs">↻ Refresh</button>
                <.link navigate={~p"/#{@locale}/sui/#{wid}/nfts"} class="text-cyan-400 hover:text-cyan-300 text-xs">Full view →</.link>
              </div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
              <%= for nft <- @nfts do %>
                <div class="bg-slate-800/60 border border-slate-700 rounded-2xl overflow-hidden hover:border-cyan-500/30 transition-all">
                  <div class="aspect-square bg-slate-700 flex items-center justify-center">
                    <%= if nft.nft_url && to_string(nft.nft_url) != "" do %>
                      <img src={to_string(nft.nft_url)} class="w-full h-full object-cover" alt={to_string(nft.nft_name || "")} />
                    <% else %>
                      <svg class="w-10 h-10 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    <% end %>
                  </div>
                  <div class="p-3">
                    <div class="text-white font-semibold text-sm truncate"><%= to_string(nft.nft_name || "Unnamed NFT") %></div>
                    <div class="text-slate-500 text-xs font-mono truncate"><%= truncate_addr(nft.object_id) %></div>
                  </div>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6">
          <div class="flex items-center justify-between mb-5">
            <h3 class="text-white font-bold text-lg">All Objects</h3>
            <button phx-click="refresh_objects" class="text-slate-400 hover:text-white text-xs">↻ Refresh</button>
          </div>
          <%= if length(@objects) == 0 do %>
            <div class="text-center py-10"><p class="text-slate-500 text-sm">No objects found in local storage.</p></div>
          <% else %>
            <div class="space-y-2">
              <%= for obj <- @objects do %>
                <div class="flex items-center justify-between p-4 bg-slate-800/50 rounded-2xl">
                  <div class="flex items-center gap-3">
                    <div class={"w-8 h-8 rounded-lg flex items-center justify-center text-sm #{if obj.is_nft, do: "bg-pink-500/20", else: "bg-slate-700"}"}>
                      <%= if obj.is_nft, do: "🎨", else: "📦" %>
                    </div>
                    <div>
                      <div class="text-white text-sm font-medium truncate max-w-xs"><%= to_string(obj.object_type || "Unknown") |> String.split("::") |> Enum.take(-2) |> Enum.join("::") %></div>
                      <div class="text-slate-500 text-xs font-mono"><%= truncate_addr(obj.object_id) %></div>
                    </div>
                  </div>
                  <div class="text-right">
                    <%= if obj.balance && to_string(obj.balance) != "" do %>
                      <div class="text-slate-300 text-xs"><%= to_string(obj.balance) %></div>
                    <% end %>
                    <span class="text-slate-500 text-xs">v<%= to_string(obj.version || "0") %></span>
                  </div>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

    <%= if @active_tab == "stakes" do %>
      <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6">
        <div class="flex items-center justify-between mb-5">
          <h3 class="text-white font-bold text-lg">Staking Positions</h3>
          <div class="flex items-center gap-3">
            <button phx-click="refresh_stakes" class="text-slate-400 hover:text-white text-xs">↻ Refresh</button>
            <.link navigate={~p"/#{@locale}/sui/#{wid}/stake"} class="text-cyan-400 hover:text-cyan-300 text-xs">Full view →</.link>
          </div>
        </div>
        <%= if length(@stakes) == 0 do %>
          <div class="text-center py-16">
            <p class="text-slate-500 mb-3">No staking positions found.</p>
            <.link navigate={~p"/#{@locale}/sui/#{wid}/stake/new"} class="inline-flex items-center gap-2 px-4 py-2 bg-gradient-to-r from-cyan-600 to-teal-600 text-white rounded-xl text-sm font-semibold">Stake SUI</.link>
          </div>
        <% else %>
          <div class="space-y-3">
            <%= for stake <- @stakes do %>
              <div class="flex items-center justify-between p-4 bg-slate-800/50 border border-slate-700/50 rounded-2xl">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 bg-green-500/20 rounded-xl flex items-center justify-center">
                    <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
                    </svg>
                  </div>
                  <div>
                    <div class="text-white font-semibold">Validator: <%= truncate_addr(stake.validator_address) %></div>
                    <%= if stake.staked_sui_id && to_string(stake.staked_sui_id) != "" do %>
                      <div class="text-slate-500 text-xs font-mono">ID: <%= truncate_addr(stake.staked_sui_id) %></div>
                    <% end %>
                    <%= if stake.stake_activation_epoch && to_string(stake.stake_activation_epoch) != "" do %>
                      <div class="text-slate-500 text-xs">Active from epoch <%= to_string(stake.stake_activation_epoch) %></div>
                    <% end %>
                  </div>
                </div>
                <div class="text-right">
                  <div class="text-white font-bold"><%= format_mist(stake.principal_mist) %> SUI</div>
                  <%= if stake.estimated_reward_mist && to_string(stake.estimated_reward_mist) != "0" do %>
                    <div class="text-green-400 text-xs">+<%= format_mist(stake.estimated_reward_mist) %> est. reward</div>
                  <% end %>
                  <span class={"px-2 py-0.5 rounded-full text-xs font-semibold #{stake_status_class(stake.status)}"}>
                    <%= to_string(stake.status || "unknown") %>
                  </span>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

  </div>
</div>

<%= if @show_update_label_modal do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click="close_update_label_modal">
    <div class="flex items-center justify-center min-h-screen px-4">
      <div class="fixed inset-0 bg-black/70 backdrop-blur-sm"></div>
      <div class="relative bg-slate-900 border border-slate-700 rounded-3xl shadow-2xl max-w-sm w-full p-8" phx-click="stop_propagation">
        <h2 class="text-xl font-bold text-white mb-5">Rename Sui Wallet</h2>
        <form phx-submit="save_label" phx-change="validate_label" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">New Label</label>
            <input type="text" name="label" value={@new_label} placeholder="e.g. Trading Wallet" class="w-full px-4 py-3 bg-slate-800 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500" />
          </div>
          <div class="flex items-center gap-3 pt-1">
            <button type="button" phx-click="close_update_label_modal" class="flex-1 px-4 py-3 bg-slate-800 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:bg-slate-700 transition-all text-sm">Cancel</button>
            <button type="submit" class="flex-1 px-4 py-3 bg-gradient-to-r from-cyan-600 to-teal-600 text-white font-semibold rounded-xl text-sm">Save</button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% end %>
