<.live_component
  module={MazarynWeb.HomeLive.NavComponent}
  id="navigation"
  user={@current_user}
  search=""
  locale={@locale}
/>

<div class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950">
  <div class="max-w-5xl mx-auto px-6 py-10">

    <div class="flex items-center gap-3 mb-8">
      <.link
        navigate={~p"/#{@locale}/aptos/#{@wallet_id}"}
        class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-all text-sm font-medium"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to Wallet
      </.link>
    </div>

    <div class="flex items-center justify-between mb-8">
      <div>
        <h1 class="text-3xl font-bold text-white">Delegation Staking</h1>
        <p class="text-slate-400 mt-1 text-sm">
          Stake APT from <span class="font-mono text-sky-400"><%= to_string(@wallet.label || "this wallet") %></span> to earn rewards
        </p>
      </div>
      <button
        phx-click="open_new_stake_modal"
        class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-sky-600 to-blue-600 text-white text-sm font-semibold hover:from-sky-700 hover:to-blue-700 transition-all shadow-lg shadow-sky-900/30"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
        New Stake
      </button>
    </div>

    <%
      total_staked_octas =
        @stakes
        |> Enum.map(fn s ->
          case Integer.parse(to_string(s.amount_octas || "0")) do
            {n, _} -> n
            :error  -> 0
          end
        end)
        |> Enum.sum()

      active_count          = Enum.count(@stakes, fn s -> to_string(s.status) == "active" end)
      pending_count         = Enum.count(@stakes, fn s -> to_string(s.status) == "pending" end)
      pending_inactive_count = Enum.count(@stakes, fn s -> to_string(s.status) == "pending_inactive" end)
      inactive_count        = Enum.count(@stakes, fn s -> to_string(s.status) == "inactive" end)
    %>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <div class="bg-gradient-to-br from-sky-900/40 to-blue-900/40 border border-sky-500/20 rounded-2xl p-5">
        <div class="text-sky-400 text-xs font-medium mb-1">Total Delegated</div>
        <div class="text-2xl font-bold text-white"><%= format_octas(total_staked_octas) %></div>
        <div class="text-sky-600 text-xs">APT</div>
      </div>
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-5">
        <div class="text-slate-400 text-xs mb-1">Active</div>
        <div class="text-2xl font-bold text-green-400"><%= active_count %></div>
        <div class="text-slate-500 text-xs">Earning rewards</div>
      </div>
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-5">
        <div class="text-slate-400 text-xs mb-1">Pending</div>
        <div class="text-2xl font-bold text-yellow-400"><%= pending_count %></div>
        <div class="text-slate-500 text-xs">Activating</div>
      </div>
      <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-5">
        <div class="text-slate-400 text-xs mb-1">Unlocking / Inactive</div>
        <div class="text-2xl font-bold text-white"><%= pending_inactive_count + inactive_count %></div>
        <div class="text-slate-500 text-xs">Withdrawable soon</div>
      </div>
    </div>

    <div class="bg-sky-900/20 border border-sky-500/20 rounded-2xl p-5 mb-8">
      <div class="flex items-start gap-3">
        <svg class="w-5 h-5 text-sky-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <div>
          <h3 class="text-sky-300 font-semibold text-sm mb-1">About Aptos Delegation Staking</h3>
          <p class="text-sky-200/70 text-xs leading-relaxed">
            Delegate APT to a delegation pool operated by an Aptos validator. You earn staking rewards every epoch without running a node. Minimum delegation is 11 APT. Unlocking takes one lockup period (~30 days). Rewards are auto-compounded until you unlock.
          </p>
        </div>
      </div>
    </div>

    <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-6">
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-white font-bold text-lg">Delegation Positions</h2>
        <button phx-click="refresh" class="text-slate-400 hover:text-white text-xs transition-colors">↻ Refresh</button>
      </div>

      <%= if length(@stakes) == 0 do %>
        <div class="text-center py-16">
          <div class="w-16 h-16 bg-sky-500/10 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
          <h3 class="text-white font-bold text-lg mb-2">No Delegation Positions</h3>
          <p class="text-slate-400 text-sm mb-5 max-w-sm mx-auto leading-relaxed">
            Delegate APT to a validator pool to start earning staking rewards. Minimum: 11 APT.
          </p>
          <button
            phx-click="open_new_stake_modal"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-gradient-to-r from-sky-600 to-blue-600 text-white text-sm font-semibold"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Delegate APT
          </button>
        </div>
      <% else %>
        <div class="space-y-3">
          <%= for stake <- @stakes do %>
            <div
              class="flex items-center justify-between p-4 bg-slate-800/50 border border-slate-700/50 rounded-2xl hover:border-slate-600 transition-all cursor-pointer"
              phx-click="select_stake"
              phx-value-stake_id={to_string(stake.stake_id)}
            >
              <div class="flex items-center gap-3">
                <div class={"w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 #{case to_string(stake.status) do "active" -> "bg-green-500/20"; "pending" -> "bg-yellow-500/20"; "pending_inactive" -> "bg-orange-500/20"; _ -> "bg-slate-700" end}"}>
                  <svg class={"w-5 h-5 #{case to_string(stake.status) do "active" -> "text-green-400"; "pending" -> "text-yellow-400"; "pending_inactive" -> "text-orange-400"; _ -> "text-slate-400" end}"} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4" />
                  </svg>
                </div>
                <div>
                  <div class="text-white font-semibold">
                    Pool: <span class="font-mono"><%= truncate_addr(stake.pool_address) %></span>
                  </div>
                  <%= if stake.active_stake && to_string(stake.active_stake) != "0" do %>
                    <div class="text-slate-500 text-xs">Active: <%= to_string(stake.active_stake) %> octas</div>
                  <% end %>
                  <%= if stake.pending_inactive_stake && to_string(stake.pending_inactive_stake) != "0" do %>
                    <div class="text-orange-400 text-xs">Unlocking: <%= to_string(stake.pending_inactive_stake) %> octas</div>
                  <% end %>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="text-right hidden sm:block">
                  <div class="text-white font-bold"><%= format_octas(stake.amount_octas) %> APT</div>
                  <div class="text-slate-500 text-xs">
                    <%= to_string(stake.network || "") %>
                  </div>
                </div>
                <span class={"px-2.5 py-1 rounded-full text-xs font-semibold #{status_class(stake.status)}"}>
                  <%= to_string(stake.status || "unknown") %>
                </span>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

  </div>
</div>

<%= if @show_new_stake_modal do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click="close_new_stake_modal">
    <div class="flex items-center justify-center min-h-screen px-4">
      <div class="fixed inset-0 bg-black/70 backdrop-blur-sm"></div>
      <div
        class="relative bg-slate-900 border border-slate-700 rounded-3xl shadow-2xl max-w-md w-full p-8"
        phx-click="stop_propagation"
      >
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-gradient-to-br from-sky-500 to-blue-600 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-white">Delegate APT</h2>
            <p class="text-slate-400 text-sm">Add to a delegation pool</p>
          </div>
          <button
            phx-click="close_new_stake_modal"
            class="ml-auto p-2 text-slate-500 hover:text-slate-300 hover:bg-slate-800 rounded-xl transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <%= if Map.get(@form_errors, :general) do %>
          <div class="mb-4 px-4 py-3 bg-red-500/10 border border-red-500/20 rounded-xl">
            <p class="text-red-400 text-sm"><%= @form_errors.general %></p>
          </div>
        <% end %>

        <form phx-submit="create_stake" phx-change="validate_stake" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Delegation Pool Address</label>
            <input
              type="text"
              name="pool_address"
              value={@pool_address}
              placeholder="0xpool..."
              class={"w-full px-4 py-3 bg-slate-800 border rounded-xl text-white placeholder-slate-500 font-mono text-sm focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all #{if Map.get(@form_errors, :pool_address), do: "border-red-500", else: "border-slate-700"}"}
            />
            <%= if Map.get(@form_errors, :pool_address) do %>
              <p class="mt-1.5 text-red-400 text-xs"><%= @form_errors.pool_address %></p>
            <% end %>
            <p class="mt-1.5 text-slate-500 text-xs">Find pools at <span class="text-sky-400">explorer.aptoslabs.com/validators</span></p>
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Amount (APT)</label>
            <input
              type="number"
              name="stake_amount_apt"
              value={@stake_amount_apt}
              placeholder="Min. 11 APT"
              step="0.00000001"
              min="11"
              class={"w-full px-4 py-3 bg-slate-800 border rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-500 transition-all #{if Map.get(@form_errors, :stake_amount_apt), do: "border-red-500", else: "border-slate-700"}"}
            />
            <%= if Map.get(@form_errors, :stake_amount_apt) do %>
              <p class="mt-1.5 text-red-400 text-xs"><%= @form_errors.stake_amount_apt %></p>
            <% end %>
            <p class="mt-1.5 text-slate-500 text-xs">1 APT = 100,000,000 octas · Minimum: 11 APT</p>
          </div>

          <div class="bg-slate-800/60 rounded-xl p-4">
            <div class="flex items-center gap-2 mb-2">
              <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span class="text-slate-300 text-xs font-semibold">Delegation Info</span>
            </div>
            <ul class="text-slate-500 text-xs space-y-1 leading-relaxed">
              <li>• Rewards auto-compound until you unlock</li>
              <li>• Unlock takes ~30 days (one lockup period)</li>
              <li>• Minimum delegation: 11 APT</li>
              <li>• Typical APY: 6–7% depending on pool</li>
            </ul>
          </div>

          <div class="flex items-center gap-3 pt-2">
            <button
              type="button"
              phx-click="close_new_stake_modal"
              class="flex-1 px-4 py-3 bg-slate-800 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:bg-slate-700 transition-all text-sm"
            >
              Cancel
            </button>
            <button
              type="submit"
              disabled={@submitting}
              class="flex-1 px-4 py-3 bg-gradient-to-r from-sky-600 to-blue-600 text-white font-semibold rounded-xl hover:from-sky-700 hover:to-blue-700 transition-all text-sm shadow-lg shadow-sky-900/30 disabled:opacity-60 disabled:cursor-not-allowed"
            >
              <%= if @submitting, do: "Delegating...", else: "Delegate APT" %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% end %>

<%= if @selected_stake do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click="close_stake_detail">
    <div class="flex items-center justify-center min-h-screen px-4">
      <div class="fixed inset-0 bg-black/70 backdrop-blur-sm"></div>
      <div
        class="relative bg-slate-900 border border-slate-700 rounded-3xl shadow-2xl max-w-md w-full p-8"
        phx-click="stop_propagation"
      >
        <div class="flex items-center justify-between mb-6">
          <h2 class="text-xl font-bold text-white">Delegation Details</h2>
          <button
            phx-click="close_stake_detail"
            class="p-2 text-slate-500 hover:text-slate-300 hover:bg-slate-800 rounded-xl transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="space-y-3 mb-6">
          <div class="flex justify-between py-2.5 border-b border-slate-800">
            <span class="text-slate-500 text-sm">Status</span>
            <span class={"px-2.5 py-1 rounded-full text-xs font-semibold #{status_class(@selected_stake.status)}"}>
              <%= to_string(@selected_stake.status || "unknown") %>
            </span>
          </div>
          <div class="flex justify-between py-2.5 border-b border-slate-800">
            <span class="text-slate-500 text-sm">Amount</span>
            <span class="text-white font-bold"><%= format_octas(@selected_stake.amount_octas) %> APT</span>
          </div>
          <div class="flex justify-between py-2.5 border-b border-slate-800">
            <span class="text-slate-500 text-sm">Active Stake</span>
            <span class="text-green-400 font-semibold"><%= to_string(@selected_stake.active_stake || "0") %> octas</span>
          </div>
          <div class="flex justify-between py-2.5 border-b border-slate-800">
            <span class="text-slate-500 text-sm">Inactive Stake</span>
            <span class="text-slate-300 text-sm"><%= to_string(@selected_stake.inactive_stake || "0") %> octas</span>
          </div>
          <div class="flex justify-between py-2.5 border-b border-slate-800">
            <span class="text-slate-500 text-sm">Pending Inactive</span>
            <span class="text-orange-400 text-sm"><%= to_string(@selected_stake.pending_inactive_stake || "0") %> octas</span>
          </div>
          <div class="flex justify-between py-2.5 border-b border-slate-800">
            <span class="text-slate-500 text-sm">Pool Address</span>
            <span class="text-slate-300 text-xs font-mono"><%= truncate_addr(@selected_stake.pool_address) %></span>
          </div>
          <div class="flex justify-between py-2.5 border-b border-slate-800">
            <span class="text-slate-500 text-sm">Network</span>
            <span class="text-slate-300 text-sm"><%= to_string(@selected_stake.network || "") %></span>
          </div>
          <%= if @selected_stake.transaction_hash && to_string(@selected_stake.transaction_hash) != "" do %>
            <div class="flex justify-between py-2.5 border-b border-slate-800">
              <span class="text-slate-500 text-sm">Tx Hash</span>
              <span class="text-slate-300 text-xs font-mono"><%= truncate_addr(@selected_stake.transaction_hash) %></span>
            </div>
          <% end %>
          <div class="flex justify-between py-2.5">
            <span class="text-slate-500 text-sm">Created</span>
            <span class="text-slate-300 text-sm"><%= format_datetime(@selected_stake.created_at) %></span>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <button
            phx-click="close_stake_detail"
            class="flex-1 px-4 py-3 bg-slate-800 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:bg-slate-700 transition-all text-sm"
          >
            Close
          </button>
          <%= if to_string(@selected_stake.status) in ["active", "pending"] do %>
            <button
              phx-click="unlock_stake"
              phx-value-stake_id={to_string(@selected_stake.stake_id)}
              data-confirm="Initiate unlock? APT will be withdrawable after the lockup period (~30 days)."
              class="flex-1 px-4 py-3 bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/20 text-orange-400 font-semibold rounded-xl transition-all text-sm"
            >
              Unlock
            </button>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
