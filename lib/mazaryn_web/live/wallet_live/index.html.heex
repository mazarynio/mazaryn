<.live_component
  module={MazarynWeb.HomeLive.NavComponent}
  id="navigation"
  user={@current_user}
  search=""
  locale={@locale}
/>

<div class="min-h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-indigo-950">
  <div class="max-w-7xl mx-auto px-6 py-10">

    <div class="mb-10">
      <div class="flex items-center justify-between">
        <div>
          <h1 class="text-4xl font-bold text-white tracking-tight">Web3 Wallet</h1>
          <p class="text-slate-400 mt-1 text-base">Manage your crypto assets across multiple networks</p>
        </div>
        <.link
          navigate={~p"/#{@locale}/home"}
          class="flex items-center gap-2 px-4 py-2 rounded-xl bg-slate-800 text-slate-300 hover:bg-slate-700 hover:text-white transition-all text-sm font-medium"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Home
        </.link>
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-10">
      <div class="bg-gradient-to-br from-violet-600 to-indigo-700 rounded-2xl p-5 shadow-xl shadow-violet-900/30 col-span-2 sm:col-span-3 lg:col-span-2">
        <div class="flex items-center justify-between mb-3">
          <span class="text-violet-200 text-sm font-medium">Total Balance</span>
          <div class="w-8 h-8 bg-white/10 rounded-lg flex items-center justify-center">
            <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
        </div>
        <div class="text-3xl font-bold text-white">$0.00</div>
        <div class="text-violet-200 text-xs mt-1">Across all wallets</div>
      </div>

      <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl p-5 shadow-xl border border-slate-700/50">
        <div class="flex items-center justify-between mb-3">
          <span class="text-slate-400 text-sm font-medium">Solana</span>
          <div class="w-8 h-8 bg-purple-500/20 rounded-lg flex items-center justify-center">
            <div class="w-4 h-4 rounded-full bg-gradient-to-br from-purple-400 to-indigo-500"></div>
          </div>
        </div>
        <div class="text-3xl font-bold text-white"><%= length(@solana_wallets) %></div>
        <div class="text-slate-400 text-xs mt-1">Wallets</div>
      </div>

      <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl p-5 shadow-xl border border-slate-700/50">
        <div class="flex items-center justify-between mb-3">
          <span class="text-slate-400 text-sm font-medium">NEAR</span>
          <div class="w-8 h-8 bg-green-500/20 rounded-lg flex items-center justify-center">
            <div class="w-4 h-4 rounded-full bg-gradient-to-br from-green-400 to-emerald-500"></div>
          </div>
        </div>
        <div class="text-3xl font-bold text-white"><%= length(@near_wallets) %></div>
        <div class="text-slate-400 text-xs mt-1">Wallets</div>
      </div>

      <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl p-5 shadow-xl border border-slate-700/50">
        <div class="flex items-center justify-between mb-3">
          <span class="text-slate-400 text-sm font-medium">Aptos</span>
          <div class="w-8 h-8 bg-sky-500/20 rounded-lg flex items-center justify-center">
            <div class="w-4 h-4 rounded-full bg-gradient-to-br from-sky-400 to-blue-500"></div>
          </div>
        </div>
        <div class="text-3xl font-bold text-white"><%= length(@aptos_wallets) %></div>
        <div class="text-slate-400 text-xs mt-1">Wallets</div>
      </div>

      <div class="bg-gradient-to-br from-slate-800 to-slate-900 rounded-2xl p-5 shadow-xl border border-slate-700/50">
        <div class="flex items-center justify-between mb-3">
          <span class="text-slate-400 text-sm font-medium">Sui</span>
          <div class="w-8 h-8 bg-cyan-500/20 rounded-lg flex items-center justify-center">
            <div class="w-4 h-4 rounded-full bg-gradient-to-br from-cyan-400 to-teal-500"></div>
          </div>
        </div>
        <div class="text-3xl font-bold text-white"><%= length(@sui_wallets) %></div>
        <div class="text-slate-400 text-xs mt-1">Wallets</div>
      </div>
    </div>

    <div class="flex items-center gap-1.5 mb-6 bg-slate-900/60 rounded-2xl p-1.5 w-fit border border-slate-800 flex-wrap">
      <%= for {tab, label, from, to, dot_from, dot_to} <- [
        {"solana",   "Solana",   "from-purple-600", "to-indigo-600",  "from-purple-400",  "to-indigo-500"},
        {"near",     "NEAR",     "from-green-600",  "to-emerald-600", "from-green-400",   "to-emerald-500"},
        {"aptos",    "Aptos",    "from-sky-600",    "to-blue-600",    "from-sky-400",     "to-blue-500"},
        {"sui",      "Sui",      "from-cyan-600",   "to-teal-600",    "from-cyan-400",    "to-teal-500"},
        {"ethereum", "Ethereum", "from-blue-600",   "to-cyan-600",    "from-blue-400",    "to-cyan-500"},
        {"bitcoin",  "Bitcoin",  "from-orange-500", "to-amber-600",   "from-orange-400",  "to-amber-500"}
      ] do %>
        <button
          phx-click="switch_wallet_tab"
          phx-value-tab={tab}
          class={"px-5 py-2.5 rounded-xl text-sm font-semibold transition-all duration-200 #{if @active_wallet_tab == tab, do: "bg-gradient-to-r #{from} #{to} text-white shadow-lg", else: "text-slate-400 hover:text-white"}"}
        >
          <div class="flex items-center gap-2">
            <div class={"w-4 h-4 rounded-full bg-gradient-to-br #{dot_from} #{dot_to}"}></div>
            <%= label %>
          </div>
        </button>
      <% end %>
    </div>

    <%= if @active_wallet_tab == "solana" do %>
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-xl font-bold text-white">Your Solana Wallets</h2>
        <div class="flex items-center gap-3">
          <button
            phx-click="open_import_modal"
            class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 hover:bg-slate-700 hover:text-white transition-all text-sm font-medium"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" />
            </svg>
            Import
          </button>
          <button
            phx-click="open_create_modal"
            class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white hover:from-purple-700 hover:to-indigo-700 transition-all text-sm font-semibold shadow-lg shadow-purple-900/30"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            New Wallet
          </button>
        </div>
      </div>

      <%= if length(@solana_wallets) == 0 do %>
        <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-16 text-center">
          <div class="w-20 h-20 bg-purple-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-10 h-10 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">No Solana Wallets Yet</h3>
          <p class="text-slate-400 max-w-sm mx-auto mb-6 text-sm leading-relaxed">
            Create your first Solana wallet to start sending, receiving, and managing SOL tokens and NFTs.
          </p>
          <div class="flex items-center justify-center gap-3">
            <button
              phx-click="open_create_modal"
              class="flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-semibold text-sm"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
              </svg>
              Create Wallet
            </button>
            <button
              phx-click="open_import_modal"
              class="flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-800 border border-slate-700 text-slate-300 font-semibold text-sm hover:bg-slate-700 hover:text-white transition-all"
            >
              Import Wallet
            </button>
          </div>
        </div>
      <% else %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          <%= for wallet <- @solana_wallets do %>
            <%
              pk  = to_string(wallet.public_key || "")
              wid = to_string(wallet.wallet_id  || "")
              lbl = to_string(wallet.label      || "Solana Wallet")
              pk_short = if String.length(pk) > 16, do: String.slice(pk, 0, 8) <> "...." <> String.slice(pk, -8, 8), else: pk
            %>
            <div class={"relative overflow-hidden rounded-3xl p-6 shadow-xl transition-all duration-300 hover:-translate-y-1 #{if wallet.is_primary, do: "bg-gradient-to-br from-purple-900/80 via-indigo-900/80 to-slate-900/80 border border-purple-500/40", else: "bg-slate-900/60 border border-slate-800 hover:border-slate-700"}"}>
              <%= if wallet.is_primary do %>
                <div class="absolute top-4 right-4">
                  <span class="px-2.5 py-1 bg-purple-500/20 border border-purple-500/30 text-purple-300 text-xs font-semibold rounded-full">Primary</span>
                </div>
              <% end %>
              <div class="flex items-start gap-4 mb-5">
                <div class={"w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0 #{if wallet.is_primary, do: "bg-gradient-to-br from-purple-500 to-indigo-600 shadow-lg", else: "bg-slate-800"}"}>
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-white font-bold text-lg leading-tight"><%= lbl %></h3>
                  <div class="flex items-center gap-2 mt-1">
                    <span class="text-slate-400 text-xs font-mono truncate"><%= pk_short %></span>
                    <button class="text-slate-500 hover:text-slate-300 transition-colors flex-shrink-0" onclick={"navigator.clipboard.writeText('#{pk}')"}>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                    </button>
                  </div>
                </div>
              </div>
              <div class="mb-5">
                <div class="text-slate-500 text-xs font-medium mb-1">SOL Balance</div>
                <div class="text-3xl font-bold text-white">0.000 <span class="text-lg text-slate-400 font-semibold">SOL</span></div>
                <div class="text-slate-500 text-xs mt-0.5">≈ $0.00 USD</div>
              </div>
              <div class="flex items-center gap-2 flex-wrap">
                <.link navigate={~p"/#{@locale}/wallet/#{wid}"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Details</.link>
                <.link navigate={~p"/#{@locale}/wallet/#{wid}/send"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Send</.link>
                <.link navigate={~p"/#{@locale}/wallet/#{wid}/transactions"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">History</.link>
                <button phx-click="open_export_modal" phx-value-wallet_id={wid} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Export Key</button>
                <%= if not wallet.is_primary do %>
                  <button phx-click="set_primary_wallet" phx-value-wallet_id={wid} class="flex items-center gap-1.5 px-3.5 py-2 bg-purple-500/20 hover:bg-purple-500/30 border border-purple-500/30 rounded-xl text-purple-300 text-xs font-semibold transition-all">Set Primary</button>
                <% end %>
                <button phx-click="delete_wallet" phx-value-wallet_id={wid} data-confirm="Delete this Solana wallet? This cannot be undone." class="flex items-center gap-1.5 px-3.5 py-2 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 rounded-xl text-red-400 text-xs font-semibold transition-all">Delete</button>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= if @active_wallet_tab == "near" do %>
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-xl font-bold text-white">Your NEAR Wallets</h2>
        <button phx-click="open_near_create_modal" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-green-600 to-emerald-600 text-white hover:from-green-700 hover:to-emerald-700 transition-all text-sm font-semibold shadow-lg shadow-green-900/30">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          New NEAR Wallet
        </button>
      </div>
      <%= if length(@near_wallets) == 0 do %>
        <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-16 text-center">
          <div class="w-20 h-20 bg-green-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-10 h-10 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">No NEAR Wallets Yet</h3>
          <p class="text-slate-400 max-w-sm mx-auto mb-6 text-sm leading-relaxed">Create your first NEAR wallet to manage NEAR tokens, stake with validators, and post to NEAR Social.</p>
          <button phx-click="open_near_create_modal" class="flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-green-600 to-emerald-600 text-white font-semibold text-sm mx-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Create NEAR Wallet
          </button>
        </div>
      <% else %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          <%= for wallet <- @near_wallets do %>
            <%
              aid = to_string(wallet.account_id || "")
              wid = to_string(wallet.wallet_id  || "")
              lbl = to_string(wallet.label      || "NEAR Wallet")
              net = to_string(wallet.network    || "testnet")
              aid_short = if String.length(aid) > 24, do: String.slice(aid, 0, 12) <> "...." <> String.slice(aid, -8, 8), else: aid
            %>
            <div class={"relative overflow-hidden rounded-3xl p-6 shadow-xl transition-all duration-300 hover:-translate-y-1 #{if wallet.is_primary, do: "bg-gradient-to-br from-green-900/80 via-emerald-900/80 to-slate-900/80 border border-green-500/40", else: "bg-slate-900/60 border border-slate-800 hover:border-slate-700"}"}>
              <%= if wallet.is_primary do %>
                <div class="absolute top-4 right-4">
                  <span class="px-2.5 py-1 bg-green-500/20 border border-green-500/30 text-green-300 text-xs font-semibold rounded-full">Primary</span>
                </div>
              <% end %>
              <div class="flex items-start gap-4 mb-5">
                <div class={"w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0 #{if wallet.is_primary, do: "bg-gradient-to-br from-green-500 to-emerald-600 shadow-lg", else: "bg-slate-800"}"}>
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-white font-bold text-lg leading-tight"><%= lbl %></h3>
                  <div class="flex items-center gap-2 mt-1">
                    <span class="text-slate-400 text-xs font-mono truncate"><%= aid_short %></span>
                    <button class="text-slate-500 hover:text-slate-300 flex-shrink-0" onclick={"navigator.clipboard.writeText('#{aid}')"}>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                    </button>
                  </div>
                  <span class={"mt-1 inline-block px-2 py-0.5 rounded-full text-xs font-semibold #{if net == "mainnet", do: "bg-green-500/20 border border-green-500/30 text-green-300", else: "bg-yellow-500/20 border border-yellow-500/30 text-yellow-300"}"}>
                    <%= net %>
                  </span>
                </div>
              </div>
              <div class="mb-5">
                <div class="text-slate-500 text-xs font-medium mb-1">NEAR Balance</div>
                <div class="text-3xl font-bold text-white">0.000 <span class="text-lg text-slate-400 font-semibold">NEAR</span></div>
                <div class="text-slate-500 text-xs mt-0.5">≈ $0.00 USD</div>
              </div>
              <div class="flex items-center gap-2 flex-wrap">
                <.link navigate={~p"/#{@locale}/near/#{wid}"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Details</.link>
                <.link navigate={~p"/#{@locale}/near/#{wid}/send"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Send</.link>
                <.link navigate={~p"/#{@locale}/near/#{wid}/stake"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Stake</.link>
                <.link navigate={~p"/#{@locale}/near/#{wid}/social"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Social</.link>
                <%= if not wallet.is_primary do %>
                  <button phx-click="set_near_primary_wallet" phx-value-wallet_id={wid} class="flex items-center gap-1.5 px-3.5 py-2 bg-green-500/20 hover:bg-green-500/30 border border-green-500/30 rounded-xl text-green-300 text-xs font-semibold transition-all">Set Primary</button>
                <% end %>
                <button phx-click="delete_near_wallet" phx-value-wallet_id={wid} data-confirm="Delete this NEAR wallet? This cannot be undone." class="flex items-center gap-1.5 px-3.5 py-2 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 rounded-xl text-red-400 text-xs font-semibold transition-all">Delete</button>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= if @active_wallet_tab == "aptos" do %>
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-xl font-bold text-white">Your Aptos Wallets</h2>
        <button phx-click="open_aptos_create_modal" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-sky-600 to-blue-600 text-white hover:from-sky-700 hover:to-blue-700 transition-all text-sm font-semibold shadow-lg shadow-sky-900/30">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          New Aptos Wallet
        </button>
      </div>
      <%= if length(@aptos_wallets) == 0 do %>
        <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-16 text-center">
          <div class="w-20 h-20 bg-sky-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-10 h-10 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">No Aptos Wallets Yet</h3>
          <p class="text-slate-400 max-w-sm mx-auto mb-6 text-sm leading-relaxed">Create your first Aptos wallet to manage APT, fungible assets, NFTs, and stake with delegation pools.</p>
          <button phx-click="open_aptos_create_modal" class="flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-sky-600 to-blue-600 text-white font-semibold text-sm mx-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Create Aptos Wallet
          </button>
        </div>
      <% else %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          <%= for wallet <- @aptos_wallets do %>
            <%
              addr = to_string(wallet.account_address || "")
              wid  = to_string(wallet.wallet_id       || "")
              lbl  = to_string(wallet.label           || "Aptos Wallet")
              net  = to_string(wallet.network         || "mainnet")
              addr_short = if String.length(addr) > 20, do: String.slice(addr, 0, 10) <> "...." <> String.slice(addr, -8, 8), else: addr
            %>
            <div class={"relative overflow-hidden rounded-3xl p-6 shadow-xl transition-all duration-300 hover:-translate-y-1 #{if wallet.is_primary, do: "bg-gradient-to-br from-sky-900/80 via-blue-900/80 to-slate-900/80 border border-sky-500/40", else: "bg-slate-900/60 border border-slate-800 hover:border-slate-700"}"}>
              <%= if wallet.is_primary do %>
                <div class="absolute top-4 right-4">
                  <span class="px-2.5 py-1 bg-sky-500/20 border border-sky-500/30 text-sky-300 text-xs font-semibold rounded-full">Primary</span>
                </div>
              <% end %>
              <div class="flex items-start gap-4 mb-5">
                <div class={"w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0 #{if wallet.is_primary, do: "bg-gradient-to-br from-sky-500 to-blue-600 shadow-lg", else: "bg-slate-800"}"}>
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-white font-bold text-lg leading-tight"><%= lbl %></h3>
                  <div class="flex items-center gap-2 mt-1">
                    <span class="text-slate-400 text-xs font-mono truncate"><%= addr_short %></span>
                    <button class="text-slate-500 hover:text-slate-300 flex-shrink-0" onclick={"navigator.clipboard.writeText('#{addr}')"}>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                    </button>
                  </div>
                  <span class={"mt-1 inline-block px-2 py-0.5 rounded-full text-xs font-semibold #{if net == "mainnet", do: "bg-sky-500/20 border border-sky-500/30 text-sky-300", else: "bg-yellow-500/20 border border-yellow-500/30 text-yellow-300"}"}>
                    <%= net %>
                  </span>
                </div>
              </div>
              <div class="mb-5">
                <div class="text-slate-500 text-xs font-medium mb-1">APT Balance</div>
                <div class="text-3xl font-bold text-white">0.000 <span class="text-lg text-slate-400 font-semibold">APT</span></div>
                <div class="text-slate-500 text-xs mt-0.5">≈ $0.00 USD</div>
              </div>
              <div class="flex items-center gap-2 flex-wrap">
                <.link navigate={~p"/#{@locale}/aptos/#{wid}"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Details</.link>
                <.link navigate={~p"/#{@locale}/aptos/#{wid}/send"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Send</.link>
                <.link navigate={~p"/#{@locale}/aptos/#{wid}/tokens"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Tokens</.link>
                <.link navigate={~p"/#{@locale}/aptos/#{wid}/nfts"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">NFTs</.link>
                <.link navigate={~p"/#{@locale}/aptos/#{wid}/stake"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Stake</.link>
                <%= if not wallet.is_primary do %>
                  <button phx-click="set_aptos_primary_wallet" phx-value-wallet_id={wid} class="flex items-center gap-1.5 px-3.5 py-2 bg-sky-500/20 hover:bg-sky-500/30 border border-sky-500/30 rounded-xl text-sky-300 text-xs font-semibold transition-all">Set Primary</button>
                <% end %>
                <button phx-click="delete_aptos_wallet" phx-value-wallet_id={wid} data-confirm="Delete this Aptos wallet? This cannot be undone." class="flex items-center gap-1.5 px-3.5 py-2 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 rounded-xl text-red-400 text-xs font-semibold transition-all">Delete</button>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= if @active_wallet_tab == "sui" do %>
      <div class="flex items-center justify-between mb-5">
        <h2 class="text-xl font-bold text-white">Your Sui Wallets</h2>
        <button phx-click="open_sui_create_modal" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-gradient-to-r from-cyan-600 to-teal-600 text-white hover:from-cyan-700 hover:to-teal-700 transition-all text-sm font-semibold shadow-lg shadow-cyan-900/30">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          New Sui Wallet
        </button>
      </div>
      <%= if length(@sui_wallets) == 0 do %>
        <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-16 text-center">
          <div class="w-20 h-20 bg-cyan-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
            <svg class="w-10 h-10 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-2">No Sui Wallets Yet</h3>
          <p class="text-slate-400 max-w-sm mx-auto mb-6 text-sm leading-relaxed">Create your first Sui wallet to manage SUI, objects, NFTs, and stake with validators using gRPC-powered transactions.</p>
          <button phx-click="open_sui_create_modal" class="flex items-center gap-2 px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-600 to-teal-600 text-white font-semibold text-sm mx-auto">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
            Create Sui Wallet
          </button>
        </div>
      <% else %>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
          <%= for wallet <- @sui_wallets do %>
            <%
              addr   = to_string(wallet.sui_address || "")
              wid    = to_string(wallet.wallet_id   || "")
              lbl    = to_string(wallet.label       || "Sui Wallet")
              net    = to_string(wallet.network     || "mainnet")
              scheme = to_string(wallet.scheme      || "ed25519")
              addr_short = if String.length(addr) > 20, do: String.slice(addr, 0, 10) <> "...." <> String.slice(addr, -8, 8), else: addr
            %>
            <div class={"relative overflow-hidden rounded-3xl p-6 shadow-xl transition-all duration-300 hover:-translate-y-1 #{if wallet.is_primary, do: "bg-gradient-to-br from-cyan-900/80 via-teal-900/80 to-slate-900/80 border border-cyan-500/40", else: "bg-slate-900/60 border border-slate-800 hover:border-slate-700"}"}>
              <%= if wallet.is_primary do %>
                <div class="absolute top-4 right-4">
                  <span class="px-2.5 py-1 bg-cyan-500/20 border border-cyan-500/30 text-cyan-300 text-xs font-semibold rounded-full">Primary</span>
                </div>
              <% end %>
              <div class="flex items-start gap-4 mb-5">
                <div class={"w-12 h-12 rounded-2xl flex items-center justify-center flex-shrink-0 #{if wallet.is_primary, do: "bg-gradient-to-br from-cyan-500 to-teal-600 shadow-lg", else: "bg-slate-800"}"}>
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                  </svg>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="text-white font-bold text-lg leading-tight"><%= lbl %></h3>
                  <div class="flex items-center gap-2 mt-1">
                    <span class="text-slate-400 text-xs font-mono truncate"><%= addr_short %></span>
                    <button class="text-slate-500 hover:text-slate-300 flex-shrink-0" onclick={"navigator.clipboard.writeText('#{addr}')"}>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                    </button>
                  </div>
                  <div class="flex items-center gap-1.5 mt-1 flex-wrap">
                    <span class={"px-2 py-0.5 rounded-full text-xs font-semibold #{if net == "mainnet", do: "bg-cyan-500/20 border border-cyan-500/30 text-cyan-300", else: "bg-yellow-500/20 border border-yellow-500/30 text-yellow-300"}"}>
                      <%= net %>
                    </span>
                    <span class="px-2 py-0.5 rounded-full text-xs font-semibold bg-slate-700/50 border border-slate-600/30 text-slate-400">
                      <%= scheme %>
                    </span>
                  </div>
                </div>
              </div>
              <div class="mb-5">
                <div class="text-slate-500 text-xs font-medium mb-1">SUI Balance</div>
                <div class="text-3xl font-bold text-white">0.000 <span class="text-lg text-slate-400 font-semibold">SUI</span></div>
                <div class="text-slate-500 text-xs mt-0.5">≈ $0.00 USD</div>
              </div>
              <div class="flex items-center gap-2 flex-wrap">
                <.link navigate={~p"/#{@locale}/sui/#{wid}"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Details</.link>
                <.link navigate={~p"/#{@locale}/sui/#{wid}/send"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Send</.link>
                <.link navigate={~p"/#{@locale}/sui/#{wid}/tokens"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Coins</.link>
                <.link navigate={~p"/#{@locale}/sui/#{wid}/nfts"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Objects</.link>
                <.link navigate={~p"/#{@locale}/sui/#{wid}/stake"} class="flex items-center gap-1.5 px-3.5 py-2 bg-white/10 hover:bg-white/15 rounded-xl text-white text-xs font-semibold transition-all">Stake</.link>
                <%= if not wallet.is_primary do %>
                  <button phx-click="set_sui_primary_wallet" phx-value-wallet_id={wid} class="flex items-center gap-1.5 px-3.5 py-2 bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/30 rounded-xl text-cyan-300 text-xs font-semibold transition-all">Set Primary</button>
                <% end %>
                <button phx-click="delete_sui_wallet" phx-value-wallet_id={wid} data-confirm="Delete this Sui wallet? This cannot be undone." class="flex items-center gap-1.5 px-3.5 py-2 bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 rounded-xl text-red-400 text-xs font-semibold transition-all">Delete</button>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    <% end %>

    <%= if @active_wallet_tab == "ethereum" do %>
      <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-16 text-center">
        <div class="w-20 h-20 bg-blue-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
          <svg class="w-10 h-10 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 2L2 12l10 10 10-10L12 2z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Ethereum Wallet</h3>
        <p class="text-slate-400 max-w-sm mx-auto mb-3 text-sm leading-relaxed">Ethereum wallet support is coming soon. You'll be able to manage ETH, ERC-20 tokens, and NFTs.</p>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold">Coming Soon</span>
      </div>
    <% end %>

    <%= if @active_wallet_tab == "bitcoin" do %>
      <div class="bg-slate-900/60 border border-slate-800 rounded-3xl p-16 text-center">
        <div class="w-20 h-20 bg-orange-500/10 rounded-2xl flex items-center justify-center mx-auto mb-5">
          <svg class="w-10 h-10 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">Bitcoin Wallet</h3>
        <p class="text-slate-400 max-w-sm mx-auto mb-3 text-sm leading-relaxed">Bitcoin wallet support is coming soon.</p>
        <span class="inline-flex items-center px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-400 text-xs font-semibold">Coming Soon</span>
      </div>
    <% end %>

  </div>
</div>

<%= if @show_create_modal do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click="close_create_modal">
    <div class="flex items-center justify-center min-h-screen px-4">
      <div class="fixed inset-0 bg-black/70 backdrop-blur-sm"></div>
      <div class="relative bg-slate-900 border border-slate-700 rounded-3xl shadow-2xl max-w-md w-full p-8" phx-click="stop_propagation">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-indigo-600 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-white">Create Solana Wallet</h2>
            <p class="text-slate-400 text-sm">A new keypair will be generated securely</p>
          </div>
          <button phx-click="close_create_modal" class="ml-auto p-2 text-slate-500 hover:text-slate-300 hover:bg-slate-800 rounded-xl transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <%= if Map.get(@form_errors, :general) do %>
          <div class="mb-4 px-4 py-3 bg-red-500/10 border border-red-500/20 rounded-xl">
            <p class="text-red-400 text-sm"><%= @form_errors.general %></p>
          </div>
        <% end %>
        <form phx-submit="create_wallet" phx-change="validate_create" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Wallet Label</label>
            <input type="text" name="label" value={@create_label} placeholder="e.g. My Main Wallet" class={"w-full px-4 py-3 bg-slate-800 border rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 transition-all #{if Map.get(@form_errors, :label), do: "border-red-500", else: "border-slate-700"}"} />
            <%= if Map.get(@form_errors, :label) do %>
              <p class="mt-1.5 text-red-400 text-xs"><%= @form_errors.label %></p>
            <% end %>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Encryption Password</label>
            <input type="password" name="password" value={@create_password} placeholder="Min. 8 characters" class={"w-full px-4 py-3 bg-slate-800 border rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-purple-500 transition-all #{if Map.get(@form_errors, :password), do: "border-red-500", else: "border-slate-700"}"} />
            <%= if Map.get(@form_errors, :password) do %>
              <p class="mt-1.5 text-red-400 text-xs"><%= @form_errors.password %></p>
            <% end %>
          </div>
          <div class="flex items-center gap-3 pt-2">
            <button type="button" phx-click="close_create_modal" class="flex-1 px-4 py-3 bg-slate-800 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:bg-slate-700 transition-all text-sm">Cancel</button>
            <button type="submit" disabled={@creating} class="flex-1 px-4 py-3 bg-gradient-to-r from-purple-600 to-indigo-600 text-white font-semibold rounded-xl hover:from-purple-700 hover:to-indigo-700 transition-all text-sm disabled:opacity-60">
              <%= if @creating, do: "Creating...", else: "Create Wallet" %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% end %>

<%= if @show_export_modal do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click="close_export_modal">
    <div class="flex items-center justify-center min-h-screen px-4">
      <div class="fixed inset-0 bg-black/70 backdrop-blur-sm"></div>
      <div class="relative bg-slate-900 border border-slate-700 rounded-3xl shadow-2xl max-w-md w-full p-8" phx-click="stop_propagation">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-gradient-to-br from-amber-500 to-orange-600 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-white">Export Private Key</h2>
            <p class="text-slate-400 text-sm">Enter your password to decrypt</p>
          </div>
          <button phx-click="close_export_modal" class="ml-auto p-2 text-slate-500 hover:text-slate-300 hover:bg-slate-800 rounded-xl transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <div class="mb-5 px-4 py-3 bg-amber-500/10 border border-amber-500/20 rounded-xl">
          <p class="text-amber-300 text-xs leading-relaxed">Never share your private key. Anyone with this key has full control of your wallet.</p>
        </div>
        <%= if @exported_key do %>
          <% exported_key_str = to_string(@exported_key) %>
          <div class="mb-5">
            <label class="block text-sm font-medium text-slate-300 mb-2">Your Private Key</label>
            <textarea readonly rows="3" class="w-full px-4 py-3 bg-slate-800 border border-green-500/30 rounded-xl text-green-400 text-xs font-mono resize-none focus:outline-none"><%= exported_key_str %></textarea>
          </div>
          <button phx-click="close_export_modal" class="w-full px-4 py-3 bg-slate-800 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:bg-slate-700 transition-all text-sm">Done</button>
        <% else %>
          <form phx-submit="export_key" phx-change="validate_export" class="space-y-5">
            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Wallet Password</label>
              <input type="password" name="password" value={@export_password} placeholder="Enter your wallet password" class={"w-full px-4 py-3 bg-slate-800 border rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-amber-500 transition-all #{if Map.get(@form_errors, :password), do: "border-red-500", else: "border-slate-700"}"} />
              <%= if Map.get(@form_errors, :password) do %>
                <p class="mt-1.5 text-red-400 text-xs"><%= @form_errors.password %></p>
              <% end %>
            </div>
            <div class="flex items-center gap-3">
              <button type="button" phx-click="close_export_modal" class="flex-1 px-4 py-3 bg-slate-800 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:bg-slate-700 transition-all text-sm">Cancel</button>
              <button type="submit" class="flex-1 px-4 py-3 bg-gradient-to-r from-amber-500 to-orange-600 text-white font-semibold rounded-xl transition-all text-sm">Decrypt & Export</button>
            </div>
          </form>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<%= if @show_near_create_modal do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click="close_near_create_modal">
    <div class="flex items-center justify-center min-h-screen px-4">
      <div class="fixed inset-0 bg-black/70 backdrop-blur-sm"></div>
      <div class="relative bg-slate-900 border border-slate-700 rounded-3xl shadow-2xl max-w-md w-full p-8" phx-click="stop_propagation">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-white">Create NEAR Wallet</h2>
            <p class="text-slate-400 text-sm">Register a human-readable account ID</p>
          </div>
          <button phx-click="close_near_create_modal" class="ml-auto p-2 text-slate-500 hover:text-slate-300 hover:bg-slate-800 rounded-xl transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <%= if Map.get(@form_errors, :general) do %>
          <div class="mb-4 px-4 py-3 bg-red-500/10 border border-red-500/20 rounded-xl">
            <p class="text-red-400 text-sm"><%= @form_errors.general %></p>
          </div>
        <% end %>
        <form phx-submit="create_near_wallet" phx-change="validate_near_create" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Account ID</label>
            <input type="text" name="account_id" value={@near_create_account_id} placeholder="e.g. alice.near or alice.testnet" class={"w-full px-4 py-3 bg-slate-800 border rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-green-500 font-mono text-sm #{if Map.get(@form_errors, :account_id), do: "border-red-500", else: "border-slate-700"}"} />
            <%= if Map.get(@form_errors, :account_id) do %>
              <p class="mt-1.5 text-red-400 text-xs"><%= @form_errors.account_id %></p>
            <% end %>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Wallet Label</label>
            <input type="text" name="label" value={@near_create_label} placeholder="e.g. My NEAR Wallet" class={"w-full px-4 py-3 bg-slate-800 border rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-green-500 #{if Map.get(@form_errors, :label), do: "border-red-500", else: "border-slate-700"}"} />
            <%= if Map.get(@form_errors, :label) do %>
              <p class="mt-1.5 text-red-400 text-xs"><%= @form_errors.label %></p>
            <% end %>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Network</label>
            <div class="flex items-center gap-3">
              <label class={"flex-1 flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition-all #{if @near_create_network == "testnet", do: "bg-yellow-500/10 border-yellow-500/30", else: "bg-slate-800 border-slate-700"}"}>
                <input type="radio" name="network" value="testnet" checked={@near_create_network == "testnet"} class="accent-yellow-500" />
                <div>
                  <div class="text-white text-sm font-semibold">Testnet</div>
                  <div class="text-slate-500 text-xs">For testing</div>
                </div>
              </label>
              <label class={"flex-1 flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition-all #{if @near_create_network == "mainnet", do: "bg-green-500/10 border-green-500/30", else: "bg-slate-800 border-slate-700"}"}>
                <input type="radio" name="network" value="mainnet" checked={@near_create_network == "mainnet"} class="accent-green-500" />
                <div>
                  <div class="text-white text-sm font-semibold">Mainnet</div>
                  <div class="text-slate-500 text-xs">Live network</div>
                </div>
              </label>
            </div>
          </div>
          <div class="flex items-center gap-3 pt-2">
            <button type="button" phx-click="close_near_create_modal" class="flex-1 px-4 py-3 bg-slate-800 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:bg-slate-700 transition-all text-sm">Cancel</button>
            <button type="submit" disabled={@near_creating} class="flex-1 px-4 py-3 bg-gradient-to-r from-green-600 to-emerald-600 text-white font-semibold rounded-xl transition-all text-sm disabled:opacity-60">
              <%= if @near_creating, do: "Creating...", else: "Create NEAR Wallet" %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% end %>

<%= if @show_aptos_create_modal do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click="close_aptos_create_modal">
    <div class="flex items-center justify-center min-h-screen px-4">
      <div class="fixed inset-0 bg-black/70 backdrop-blur-sm"></div>
      <div class="relative bg-slate-900 border border-slate-700 rounded-3xl shadow-2xl max-w-md w-full p-8" phx-click="stop_propagation">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-gradient-to-br from-sky-500 to-blue-600 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-white">Create Aptos Wallet</h2>
            <p class="text-slate-400 text-sm">Ed25519 keypair on Aptos blockchain</p>
          </div>
          <button phx-click="close_aptos_create_modal" class="ml-auto p-2 text-slate-500 hover:text-slate-300 hover:bg-slate-800 rounded-xl transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <%= if Map.get(@form_errors, :general) do %>
          <div class="mb-4 px-4 py-3 bg-red-500/10 border border-red-500/20 rounded-xl">
            <p class="text-red-400 text-sm"><%= @form_errors.general %></p>
          </div>
        <% end %>
        <form phx-submit="create_aptos_wallet" phx-change="validate_aptos_create" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Wallet Label</label>
            <input type="text" name="label" value={@aptos_create_label} placeholder="e.g. My Aptos Wallet" class={"w-full px-4 py-3 bg-slate-800 border rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-sky-500 #{if Map.get(@form_errors, :label), do: "border-red-500", else: "border-slate-700"}"} />
            <%= if Map.get(@form_errors, :label) do %>
              <p class="mt-1.5 text-red-400 text-xs"><%= @form_errors.label %></p>
            <% end %>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Network</label>
            <div class="flex items-center gap-3">
              <%= for {val, label, accent, active_bg} <- [{"mainnet", "Mainnet", "accent-sky-500", "bg-sky-500/10 border-sky-500/30"}, {"testnet", "Testnet", "accent-yellow-500", "bg-yellow-500/10 border-yellow-500/30"}] do %>
                <label class={"flex-1 flex items-center gap-3 p-3 rounded-xl border cursor-pointer transition-all #{if @aptos_create_network == val, do: active_bg, else: "bg-slate-800 border-slate-700"}"}>
                  <input type="radio" name="network" value={val} checked={@aptos_create_network == val} class={accent} />
                  <div class="text-white text-sm font-semibold"><%= label %></div>
                </label>
              <% end %>
            </div>
          </div>
          <div class="flex items-center gap-3 pt-2">
            <button type="button" phx-click="close_aptos_create_modal" class="flex-1 px-4 py-3 bg-slate-800 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:bg-slate-700 transition-all text-sm">Cancel</button>
            <button type="submit" disabled={@aptos_creating} class="flex-1 px-4 py-3 bg-gradient-to-r from-sky-600 to-blue-600 text-white font-semibold rounded-xl transition-all text-sm disabled:opacity-60">
              <%= if @aptos_creating, do: "Creating...", else: "Create Aptos Wallet" %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% end %>

<%= if @show_sui_create_modal do %>
  <div class="fixed inset-0 z-50 overflow-y-auto" phx-click="close_sui_create_modal">
    <div class="flex items-center justify-center min-h-screen px-4">
      <div class="fixed inset-0 bg-black/70 backdrop-blur-sm"></div>
      <div class="relative bg-slate-900 border border-slate-700 rounded-3xl shadow-2xl max-w-md w-full p-8" phx-click="stop_propagation">
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 bg-gradient-to-br from-cyan-500 to-teal-600 rounded-xl flex items-center justify-center">
            <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
            </svg>
          </div>
          <div>
            <h2 class="text-xl font-bold text-white">Create Sui Wallet</h2>
            <p class="text-slate-400 text-sm">Ed25519, Secp256k1, or Secp256r1 keypair</p>
          </div>
          <button phx-click="close_sui_create_modal" class="ml-auto p-2 text-slate-500 hover:text-slate-300 hover:bg-slate-800 rounded-xl transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
        <%= if Map.get(@form_errors, :general) do %>
          <div class="mb-4 px-4 py-3 bg-red-500/10 border border-red-500/20 rounded-xl">
            <p class="text-red-400 text-sm"><%= @form_errors.general %></p>
          </div>
        <% end %>
        <form phx-submit="create_sui_wallet" phx-change="validate_sui_create" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Wallet Label</label>
            <input type="text" name="label" value={@sui_create_label} placeholder="e.g. My Sui Wallet" class={"w-full px-4 py-3 bg-slate-800 border rounded-xl text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-cyan-500 #{if Map.get(@form_errors, :label), do: "border-red-500", else: "border-slate-700"}"} />
            <%= if Map.get(@form_errors, :label) do %>
              <p class="mt-1.5 text-red-400 text-xs"><%= @form_errors.label %></p>
            <% end %>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Key Scheme</label>
            <div class="grid grid-cols-3 gap-2">
              <%= for scheme <- ["ed25519", "secp256k1", "secp256r1"] do %>
                <label class={"flex flex-col items-center gap-1.5 p-3 rounded-xl border cursor-pointer transition-all #{if @sui_create_scheme == scheme, do: "bg-cyan-500/10 border-cyan-500/30", else: "bg-slate-800 border-slate-700 hover:border-slate-600"}"}>
                  <input type="radio" name="scheme" value={scheme} checked={@sui_create_scheme == scheme} class="accent-cyan-500 sr-only" />
                  <span class="text-white text-xs font-semibold"><%= scheme %></span>
                </label>
              <% end %>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Network</label>
            <div class="grid grid-cols-2 gap-2">
              <%= for {val, label, active_bg} <- [{"mainnet", "Mainnet", "bg-cyan-500/10 border-cyan-500/30"}, {"testnet", "Testnet", "bg-yellow-500/10 border-yellow-500/30"}, {"devnet", "Devnet", "bg-orange-500/10 border-orange-500/30"}, {"localnet", "Localnet", "bg-slate-700/50 border-slate-600/30"}] do %>
                <label class={"flex items-center gap-2 p-2.5 rounded-xl border cursor-pointer transition-all #{if @sui_create_network == val, do: active_bg, else: "bg-slate-800 border-slate-700"}"}>
                  <input type="radio" name="network" value={val} checked={@sui_create_network == val} class="accent-cyan-500" />
                  <span class="text-white text-xs font-semibold"><%= label %></span>
                </label>
              <% end %>
            </div>
          </div>
          <div class="flex items-center gap-3 pt-2">
            <button type="button" phx-click="close_sui_create_modal" class="flex-1 px-4 py-3 bg-slate-800 border border-slate-700 text-slate-300 font-semibold rounded-xl hover:bg-slate-700 transition-all text-sm">Cancel</button>
            <button type="submit" disabled={@sui_creating} class="flex-1 px-4 py-3 bg-gradient-to-r from-cyan-600 to-teal-600 text-white font-semibold rounded-xl transition-all text-sm disabled:opacity-60">
              <%= if @sui_creating, do: "Creating...", else: "Create Sui Wallet" %>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
<% end %>
